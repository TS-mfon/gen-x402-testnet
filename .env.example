# Public application URL
APP_URL=https://gen-x402-testnet.vercel.app

# Vercel Blob (automatically injected when a Blob store is connected)
BLOB_READ_WRITE_TOKEN=

# x402 seller configuration
X402_TREASURY_ADDRESS=0x0000000000000000000000000000000000000000
BASE_USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
X402_NETWORK=eip155:84532
X402_FACILITATOR_URL=https://api.cdp.coinbase.com/platform/v2/x402
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_WALLET_SECRET=

# x402 buyer operations wallet is the named CDP account gen-x402-testnet-operations.
# Keep only a small capped USDC balance on each enabled network.
X402_PROVIDERS_JSON=[]
CDP_DISCOVERY_URL=https://api.cdp.coinbase.com/platform/v2/x402/discovery/search?network=eip155:84532
TESTNET_JOB_BUDGET_ATOMIC=500000
TESTNET_DAILY_BUDGET_ATOMIC=5000000

# GenLayer Studionet
GENLAYER_CONTRACT_ADDRESS=0x3dB29d17DC0c54f57bcfe744d240b75E4003Bf7C
GENLAYER_SIGNER_PRIVATE_KEY=

# Server-only secrets
CRON_SECRET=
